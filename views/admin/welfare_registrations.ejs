<% header('Welfare Registrations'); %>
<div style="display:flex;align-items:center;gap:16px;margin-bottom:24px;">
  <img src="/images/logo.jpeg" alt="Logo" style="width:56px;height:56px;border-radius:50%;object-fit:cover;border:2px solid #3b82f6;padding:2px;background:#fff;" onerror="this.style.display='none'">
  <div>
    <div class="page-title" style="margin-bottom:2px;">Welfare Registrations</div>
    <p class="page-subtitle" style="margin-bottom:0;">Submitted membership registration forms</p>
  </div>
</div>

<div class="card" style="border-top:4px solid #3b82f6;">
  <div class="table-wrap">
    <table>
      <tr><th>#</th><th>Member</th><th>Submitted</th><th>Edit Requested</th><th>Actions</th></tr>
      <% if (registrations.length === 0) { %>
      <tr><td colspan="5" style="text-align:center;padding:40px;color:var(--text-muted);">No submitted welfare registrations</td></tr>
      <% } %>
      <% registrations.forEach(r => { %>
      <tr>
        <td><span class="badge badge-closed"><%= r.member_number %></span></td>
        <td><strong><%= r.first_name %> <%= r.last_name %></strong></td>
        <td><%= new Date(r.submitted_at).toLocaleDateString() %></td>
        <td><%= r.edit_requested ? '<span class="badge badge-warning">Yes</span>' : '<span class="badge badge-closed">No</span>' %></td>
        <td>
          <a href="/admin/welfare/registrations/<%= r.id %>" class="btn btn-sm btn-primary">View</a>
          <% if (r.edit_requested && (user.admin_role === 'chairman' || user.admin_role === 'treasurer')) { %>
          <form method="POST" action="/admin/welfare/registrations/unlock/<%= r.id %>" style="display:inline;">
            <button class="btn btn-sm btn-warning">Unlock for Edit</button>
          </form>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </table>
  </div>
</div>