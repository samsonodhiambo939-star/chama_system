<% header('Member Contributions'); %>
<div class="page-title">Contributions: <%= member.first_name %> <%= member.last_name %></div>
<p class="page-subtitle"><%= member.member_number %> — Breakdown per cycle</p>

<div class="card">
  <div class="card-header"><h2>Contribution Breakdown by Cycle</h2></div>
  <% const cycleKeys = Object.keys(cycleData); %>
  <% if (cycleKeys.length === 0) { %>
    <div class="empty-state"><div class="empty-icon">📋</div><div class="empty-text">No contributions yet for this member.</div></div>
  <% } else { %>
    <% cycleKeys.forEach(key => { %>
      <% const cd = cycleData[key]; %>
      <div style="border:1px solid #e2e8f0;border-radius:10px;padding:16px;margin-bottom:12px;">
        <div style="font-weight:700;font-size:16px;margin-bottom:10px;">Cycle: <%= cd.start_date %> &rarr; <%= cd.end_date %></div>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;">
          <% funds.forEach(f => { %>
            <div style="background:<%= cd.funds[f.name] ? (cd.funds[f.name].status === 'approved' ? '#f0fdf4' : '#fef3c7') : '#f8fafc' %>;border-radius:8px;padding:10px;text-align:center;">
              <div style="font-size:12px;color:#64748b;font-weight:600;text-transform:uppercase;"><%= f.name %></div>
              <div style="font-size:18px;font-weight:800;margin:4px 0;">
                KES <%= Number(cd.funds[f.name] ? cd.funds[f.name].amount : 0).toLocaleString() %>
              </div>
              <div><span class="badge badge-<%= cd.funds[f.name] ? cd.funds[f.name].status : 'none' %>"><%= cd.funds[f.name] ? cd.funds[f.name].status : 'N/A' %></span></div>
              <% if (cd.funds[f.name]) { %>
                <div class="text-xs text-muted"><%= new Date(cd.funds[f.name].created_at).toLocaleDateString() %></div>
              <% } %>
            </div>
          <% }) %>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<a href="/admin/members" class="btn btn-outline">&larr; Back to Members</a>
