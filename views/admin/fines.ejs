<% header('Manage Fines'); %>
<div class="page-title">Fines Management</div>
<p class="page-subtitle">Add and manage member fines for late payments or penalties</p>

<div class="card">
  <div class="card-header"><h3>Add Fine</h3></div>
  <form method="POST" action="/admin/fines/add">
    <div class="form-row">
      <div class="form-group"><label>Member</label><select name="member_id" required><% members.forEach(m => { %><option value="<%= m.id %>"><%= m.first_name %> <%= m.last_name %> (<%= m.member_number %>)</option><% }) %></select></div>
      <div class="form-group"><label>Amount (KES)</label><input type="number" name="amount" min="1" max="10000000" step="1" required></div>
      <div class="form-group"><label>Reason</label><input name="reason" placeholder="e.g. Late payment" value="Late penalty"></div>
      <div class="form-group" style="display:flex;align-items:flex-end;"><button class="btn btn-danger">Add Fine</button></div>
    </div>
  </form>
</div>

<div class="card">
  <div class="card-header"><h2>All Fines</h2></div>
  <div class="table-wrap">
    <table>
      <tr><th>Member</th><th>Amount</th><th>Balance</th><th>Reason</th><th>Date</th><th>Status</th></tr>
      <% fines.forEach(f => { %>
        <tr>
          <td><strong><%= f.first_name %> <%= f.last_name %></strong><br><span class="text-xs text-muted"><%= f.member_number %></span></td>
          <td style="font-weight:700;">KES <%= Number(f.amount).toLocaleString() %></td>
          <td>KES <%= Number(f.balance).toLocaleString() %></td>
          <td><%= f.reason %></td>
          <td class="text-sm"><%= new Date(f.created_at).toLocaleDateString() %></td>
          <td><span class="badge badge-<%= f.status %>"><%= f.status %></span></td>
        </tr>
      <% }) %>
    </table>
  </div>
</div>
