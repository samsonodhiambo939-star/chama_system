<% header('Approvals'); %>
<div class="page-title">Pending Approvals</div>
<p class="page-subtitle">Review and approve contributions, loan applications, and repayments</p>

<div style="display:flex;gap:12px;align-items:center;margin-bottom:20px;flex-wrap:wrap;">
  <input id="searchInput" placeholder="Search member..." style="flex:1;min-width:200px;padding:10px 14px;border:1.5px solid var(--border);border-radius:8px;font-size:14px;background:var(--input-bg);color:var(--text);">
</div>

<% if (pendingContributions.length === 0 && pendingLoans.length === 0 && pendingPayments.length === 0) { %>
  <div class="alert alert-success">
    <span class="alert-icon">✅</span>
    <span>All caught up! No pending items to review.</span>
  </div>
<% } %>

<% if (pendingContributions.length > 0) { %>
  <div class="card">
    <div class="card-header">
      <h2>Cycle Contributions</h2>
      <div style="display:flex;gap:8px;align-items:center;">
        <span class="badge badge-pending"><%= pendingContributions.length %> pending</span>
        <form method="POST" action="/admin/contributions/approve-all" style="display:inline;" onsubmit="return confirm('Approve all <%= pendingContributions.length %> pending contributions?')">
          <button class="btn btn-success btn-sm">Approve All</button>
        </form>
      </div>
    <div class="table-wrap">
      <table>
        <tr><th>Member</th><th>Fund</th><th style="text-align:right">Amount</th><th>Cycle</th><th>Submitted</th><th>Actions</th></tr>
        <% pendingContributions.forEach(c => { %>
          <tr>
            <td><strong><%= c.first_name %> <%= c.last_name %></strong><br><span class="text-xs text-muted"><%= c.member_number %></span></td>
            <td><%= c.fund %></td>
            <td style="text-align:right;font-weight:700;">KES <%= Number(c.amount).toLocaleString() %></td>
            <td class="text-sm"><%= c.start_date %> — <%= c.end_date %></td>
            <td class="text-sm"><%= new Date(c.created_at).toLocaleDateString() %></td>
            <td style="white-space:nowrap;">
              <form method="POST" action="/admin/contributions/approve/<%= c.id %>" style="display:inline;">
                <button class="btn btn-success btn-sm">Approve</button>
              </form>
              <form method="POST" action="/admin/contributions/reject/<%= c.id %>" style="display:inline;" onsubmit="event.preventDefault();confirmAction('Reject this contribution?',function(){this.submit()}.bind(this))">
                <button class="btn btn-danger btn-sm">Reject</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </table>
    </div>
  </div>
<% } %>

<% if (pendingLoans.length > 0) { %>
  <div class="card">
    <div class="card-header">
      <h2>Loan Applications</h2>
      <span class="badge badge-pending"><%= pendingLoans.length %> pending</span>
    </div>
    <div class="table-wrap">
      <table>
        <tr><th>Member</th><th style="text-align:right">Amount</th><th style="text-align:right">With 10% Interest</th><th>Applied</th><th>Actions</th></tr>
        <% pendingLoans.forEach(l => { %>
          <tr>
            <td><strong><%= l.first_name %> <%= l.last_name %></strong><br><span class="text-xs text-muted"><%= l.member_number %></span></td>
            <td style="text-align:right;font-weight:700;">KES <%= Number(l.amount).toLocaleString() %></td>
            <td style="text-align:right;font-weight:700;color:#ef4444;">KES <%= Number(l.amount * 1.1).toLocaleString() %></td>
            <td class="text-sm"><%= new Date(l.created_at).toLocaleDateString() %></td>
            <td style="white-space:nowrap;">
              <form method="POST" action="/admin/loans/approve/<%= l.id %>" style="display:inline;">
                <button class="btn btn-success btn-sm">✅ Approve (10% auto-applied)</button>
              </form>
              <form method="POST" action="/admin/loans/reject/<%= l.id %>" style="display:inline;" onsubmit="event.preventDefault();confirmAction('Reject this loan application?',function(){this.submit()}.bind(this))">
                <button class="btn btn-danger btn-sm">Reject</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </table>
    </div>
  </div>
<% } %>

<% if (pendingPayments.length > 0) { %>
  <div class="card">
    <div class="card-header">
      <h2>Repayments</h2>
      <div style="display:flex;gap:8px;align-items:center;">
        <span class="badge badge-pending"><%= pendingPayments.length %> pending</span>
        <form method="POST" action="/admin/payments/approve-all" style="display:inline;" onsubmit="return confirm('Approve all <%= pendingPayments.length %> pending payments?')">
          <button class="btn btn-success btn-sm">Approve All</button>
        </form>
      </div>
    <div class="table-wrap">
      <table>
        <tr><th>Member</th><th>Type</th><th>Description</th><th style="text-align:right">Amount</th><th>Submitted</th><th>Actions</th></tr>
        <% pendingPayments.forEach(r => { %>
          <tr>
            <td><strong><%= r.first_name %> <%= r.last_name %></strong><br><span class="text-xs text-muted"><%= r.member_number %></span></td>
            <td><span class="badge badge-<%= r.payment_type === 'fine' ? 'warning' : (r.payment_type === 'loan' ? 'info' : 'info') %>"><%= r.payment_type === 'fine' ? 'Fine' : (r.payment_type === 'loan' ? 'Loan' : 'Card') %></span></td>
            <td class="text-sm"><%= r.description || '—' %></td>
            <td style="text-align:right;font-weight:700;">KES <%= Number(r.amount).toLocaleString() %></td>
            <td class="text-sm"><%= new Date(r.created_at).toLocaleDateString() %></td>
            <td style="white-space:nowrap;">
              <form method="POST" action="/admin/payments/approve/<%= r.id %>" style="display:inline;">
                <button class="btn btn-success btn-sm">Approve</button>
              </form>
              <form method="POST" action="/admin/payments/reject/<%= r.id %>" style="display:inline;" onsubmit="event.preventDefault();confirmAction('Reject this payment?',function(){this.submit()}.bind(this))">
                <button class="btn btn-danger btn-sm">Reject</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </table>
    </div>
  </div>
<% } %>

<script>
document.getElementById('searchInput').addEventListener('input', function(){
  var v = this.value.toLowerCase();
  document.querySelectorAll('.card table tr').forEach(function(tr,i){
    if(i===0) return;
    tr.style.display = tr.textContent.toLowerCase().includes(v) ? '' : 'none';
  });
});
</script>
