<% header('My Dashboard'); %>
<div style="display:flex;align-items:center;gap:16px;margin-bottom:24px;">
  <% if (memberPhoto) { %>
    <img src="<%= memberPhoto %>" alt="photo" style="width:64px;height:64px;border-radius:50%;object-fit:cover;border:3px solid var(--border);">
  <% } else { %>
    <div style="width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,#3b82f6,#06b6d4);display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:700;color:#fff;"><%= user.memberName.charAt(0) %></div>
  <% } %>
  <div>
    <div class="page-title" style="margin-bottom:4px;">Welcome, <%= user.memberName %></div>
    <p class="text-muted text-sm"><%= user.memberNumber %> — your complete financial overview</p>
  </div>
</div>

<!-- Reminders -->
<div class="reminder-bar">
  <% if (currentCycle) { %>
    <div class="reminder-chip <%= hasContributed ? 'success' : 'warning' %>">
      <span><%= hasContributed ? '✅ Contributed' : '⏳ Cycle open: ' + currentCycle.end_date %></span>
    </div>
  <% } %>
  <% if (activeLoan) { var remain = activeLoan.amount_due - activeLoan.paid_amount; %>
    <div class="reminder-chip danger"><span>🏦 Loan balance: KES <%= Number(remain).toLocaleString() %></span></div>
  <% } %>
  <% if (totalFines > 0) { %>
    <div class="reminder-chip danger"><span>⚖️ Fines: KES <%= Number(totalFines).toLocaleString() %></span></div>
  <% } %>
  <% if (cardBalance > 0) { %>
    <div class="reminder-chip warning"><span>💳 Card: KES <%= Number(cardBalance).toLocaleString() %></span></div>
  <% } %>
  <% if (pendingLoanPayments > 0) { %>
    <div class="reminder-chip warning"><span>⏳ Loan pay pending</span></div>
  <% } %>
</div>

<% if (pendingContribs > 0 || pendingLoan > 0 || totalFines > 0 || cardBalance > 0 || pendingFinePayments > 0 || pendingCardPayments > 0 || pendingLoanPayments > 0) { %>
  <div class="alert alert-warning" style="margin-bottom:24px;">
    <span class="alert-icon">⏳</span>
    <span style="flex:1">
      <% if (pendingContribs > 0) { %><%= pendingContribs %> contribution(s) pending &middot; <% } %>
      <% if (pendingLoan > 0) { %>Loan pending &middot; <% } %>
      <% if (totalFines > 0) { %>Fines: KES <%= Number(totalFines).toLocaleString() %> &middot; <% } %>
      <% if (cardBalance > 0) { %>Card: KES <%= Number(cardBalance).toLocaleString() %> &middot; <% } %>
      <% if (pendingFinePayments > 0) { %>Fine pay pending &middot; <% } %>
      <% if (pendingCardPayments > 0) { %>Card pay pending &middot; <% } %>
      <% if (pendingLoanPayments > 0) { %>Loan pay pending<% } %>
    </span>
  </div>
<% } %>

<div class="dash-grid">
  <% 
    const squares = [
      { name: 'Welfare', balance: balances[0]?.balance || 0, icon: '🛡️', color: 'linear-gradient(135deg, #b8860b, #daa520)', label: 'Emergency support', link: '/member/fund/1' },
      { name: 'Savings', balance: balances[1]?.balance || 0, icon: '💰', color: 'linear-gradient(135deg, #71706e, #c0c0c0)', label: 'General savings', link: '/member/fund/2' },
      { name: 'Loan Balance', balance: activeLoan ? activeLoan.amount_due - activeLoan.paid_amount : 0, icon: '🏦', color: 'linear-gradient(135deg, #8b4513, #cd7f32)', label: activeLoan ? 'Outstanding balance' : 'No active loan', link: '/member/loans' },
      { name: 'Development', balance: balances[3]?.balance || 0, icon: '📈', color: 'linear-gradient(135deg, #495057, #e5e4e2)', label: 'Investment fund', link: '/member/fund/4' },
      { name: 'Fines', balance: totalFines, icon: '⚖️', color: 'linear-gradient(135deg, #8b0000, #dc143c)', label: 'Pending penalties', link: '/member/fines' },
      { name: 'Member Card', balance: cardBalance, icon: '💳', color: 'linear-gradient(135deg, #006d77, #20b2aa)', label: 'Card account', link: '/member/membercard' }
    ];
  %>
  <% squares.forEach(s => { %>
    <a href="<%= s.link || '#' %>" class="dash-square" style="background: <%= s.color %>;">
      <div class="sq-icon"><%= s.icon %></div>
      <div class="sq-label"><%= s.name %></div>
      <div class="sq-value">KES <%= Number(s.balance).toLocaleString() %></div>
      <div class="sq-sub"><%= s.label %></div>
    </a>
  <% }) %>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:24px;">
  <% if (currentCycle) { %>
    <div class="alert <%= hasContributed ? 'alert-success' : 'alert-info' %>" style="margin-bottom:0;">
      <span class="alert-icon"><%= hasContributed ? '✅' : 'ℹ️' %></span>
      <span style="flex:1"><%= hasContributed ? 'Contributions submitted. Awaiting approval.' : 'Cycle active: ' + currentCycle.start_date + ' to ' + currentCycle.end_date %></span>
      <a href="/member/contribute" class="btn btn-sm <%= hasContributed ? 'btn-outline' : 'btn-primary' %>">Contribute</a>
    </div>
  <% } else { %>
    <div class="alert alert-info" style="margin-bottom:0;"><span class="alert-icon">ℹ️</span>No active cycle</div>
  <% } %>
  <div class="alert <%= activeLoan ? 'alert-warning' : 'alert-success' %>" style="margin-bottom:0;">
    <span class="alert-icon"><%= activeLoan ? '🏦' : '✅' %></span>
    <span style="flex:1"><%= activeLoan ? 'Loan balance: KES ' + Number(activeLoan.amount_due - activeLoan.paid_amount).toLocaleString() : 'No active loans' %></span>
    <a href="/member/loans" class="btn btn-sm btn-outline">Loans</a>
  </div>
</div>

<!-- Contribution Trend Chart -->
<div class="card" style="margin-top:24px;">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
    <h3>Contribution Trend</h3>
    <label style="font-size:13px;color:var(--text-secondary);">Last 6 cycles</label>
  </div>
  <canvas id="contribChart" style="max-height:300px;"></canvas>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
fetch('/api/chart/contributions').then(r=>r.json()).then(data=>{
  if(!data.length) return;
  const labels = data.map(d=>d.cycle.substring(0,10));
  const colors = ['#daa520','#c0c0c0','#8b4513','#e5e4e2'];
  const funds = Object.keys(data[0]).filter(k=>k!=='cycle');
  const ds = funds.map((f,i)=>({label:f,data:data.map(d=>d[f]||0),backgroundColor:colors[i]||'#999'}));
  new Chart(document.getElementById('contribChart'),{type:'bar',data:{labels,datasets:ds},options:{responsive:true,scales:{x:{stacked:!0},y:{stacked:!0,beginAtZero:!0}},plugins:{legend:{position:'bottom',labels:{color:'var(--text-secondary)'}}}}});
});
</script>
